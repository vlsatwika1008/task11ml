import pandas as pd

# Import Random Forest classifier
from sklearn.ensemble import RandomForestClassifier

# Define column names
names = [
    'preg', 'plas', 'pres', 'skin',
    'test', 'mass', 'pedi', 'age', 'class'
]

# Read diabetes dataset
data = pd.read_csv('diabetes.csv', names=names)

# Display dataset
print(data)

# Select input features by dropping target column
X = data.drop('class', axis=1)

# Select target column
y = data['class']

# Split data into training and testing sets
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.33, random_state=66
)

# Create Random Forest classifier
rfc = RandomForestClassifier()

# Train the model
rfc.fit(X_train, y_train)

# Predict test data
rfc_predict = rfc.predict(X_test)

# Import cross-validation function
from sklearn.model_selection import cross_val_score

# Import evaluation metrics
from sklearn.metrics import classification_report, confusion_matrix

# Perform 10-fold cross-validation using ROC AUC
rfc_cv_score = cross_val_score(
    rfc, X, y, cv=10, scoring='roc_auc'
)

# Display confusion matrix
print("=== Confusion Matrix ===")
print(confusion_matrix(y_test, rfc_predict))

# Display classification report
print("\n=== Classification Report ===")
print(classification_report(y_test, rfc_predict))

# Display all AUC scores
print("\n=== All AUC Scores ===")
print(rfc_cv_score)

# Display mean AUC score
print("\n=== Mean AUC Score ===")
print("Mean AUC Score - Random Forest:",
      rfc_cv_score.mean())

# Import utility modules
import pandas as pd
import numpy as np

# Import Mean Squared Error
from sklearn.metrics import mean_squared_error

# Import Gradient Boosting Regressor
from sklearn.ensemble import GradientBoostingRegressor

# Define column names
col_names = [
    'pregnant', 'glucose', 'bp', 'skin',
    'insulin', 'bmi', 'pedigree', 'age', 'label'
]

# Load diabetes dataset
pima = pd.read_csv(
    'diabetes.csv',
    header=None,
    names=col_names
)

# Display dataset
print(pima)

# Select input features
feature_cols = [
    'pregnant', 'insulin', 'bmi',
    'age', 'glucose', 'bp'
]

# Select features
X = pima[feature_cols]

# Select target
y = pima.label

# Split data into training and testing sets
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20
)

# Create Gradient Boosting Regressor
model = GradientBoostingRegressor()

# Train the model
model.fit(X_train, y_train)

# Predict test data
y_pred = model.predict(X_test)

# Calculate R2 score
from sklearn.metrics import r2_score

print('score==', r2_score(y_test, y_pred))

# Calculate Mean Squared Error
print('mean_sqrd_error is==',
      mean_squared_error(y_test, y_pred))

# Calculate Root Mean Squared Error
print('root_mean_squared error is==',
      np.sqrt(mean_squared_error(y_test, y_pred)))
